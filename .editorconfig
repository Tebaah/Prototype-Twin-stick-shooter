# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown (respetar espacios de tablas/listas)
[*.{md,markdown}]
trim_trailing_whitespace = false

# C# (.NET): Godot recomienda 4 espacios
[*.cs]
indent_style = space
indent_size = 4

# GDScript (por si se añaden scripts auxiliares): Godot usa tabuladores
[*.gd]
indent_style = tab
indent_size = 4

# XML de proyecto .NET
[*.{csproj,props,targets}]
indent_style = space
indent_size = 2

# Archivos de Godot generados por el editor
[*.{tscn,tres,godot,import}]
indent_style = space
indent_size = 4

